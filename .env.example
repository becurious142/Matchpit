# ─────────────────────────────────────────────────────────────
# MATCHPIT — Environment Variables
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Clerk Authentication ──────────────────────────────────────
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Frontend (Vite) — must be prefixed with VITE_
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Optional: Clerk proxy URL for custom domain auth
# Set to https://your-api-domain.com/api/__clerk when using cross-origin deploy
VITE_CLERK_PROXY_URL=

# ── Razorpay Payments ─────────────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Frontend (Vite)
VITE_RAZORPAY_KEY_ID=rzp_live_...

# ── CORS / Cross-Origin ───────────────────────────────────────
# Comma-separated list of allowed frontend origins (production only)
# Example: https://matchpit.in,https://www.matchpit.in,https://matchpit.vercel.app
CORS_ORIGINS=https://matchpit.in,https://www.matchpit.in

# Single frontend URL shorthand (used if CORS_ORIGINS not set)
FRONTEND_URL=https://matchpit.in

# ── Frontend API Base URL ─────────────────────────────────────
# VERCEL SAME-DOMAIN DEPLOY: Leave empty — /api/* calls are handled by
# Vercel rewrites on the same domain. No cross-origin needed.
#
# HYBRID DEPLOY (Vercel frontend + Replit backend): Set to the Replit API URL.
# Example: https://matchpit-api.replit.app
VITE_API_BASE_URL=

# ── Server ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Vite Dev Server (Replit only) ─────────────────────────────
# These are set automatically by Replit artifact runner.
# Only needed for local dev outside Replit.
# PORT=24208
# BASE_PATH=/
# API_PORT=8080
