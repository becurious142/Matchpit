# ─────────────────────────────────────────────────────────────
# MATCHPIT — Production Environment Variables
# For Vercel deployment. Copy this to .env.production in Vercel dashboard.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Production PostgreSQL (Neon or similar)
DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# ── Clerk Authentication ──────────────────────────────────────
# Production keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Next.js) — must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Clerk proxy URL for custom domain auth
# Set to https://your-api-domain.com/api/__clerk when using cross-origin deploy
NEXT_PUBLIC_CLERK_PROXY_URL=https://your-api-domain.com

# ── Razorpay Payments ─────────────────────────────────────────
# Production keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (Next.js)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# ── CORS / Cross-Origin ───────────────────────────────────────
# Comma-separated list of allowed frontend origins (production only)
# Example: https://matchpit.in,https://www.matchpit.in,https://matchpit.vercel.app
CORS_ORIGINS=https://your-frontend-domain.com

# Single frontend URL shorthand (used if CORS_ORIGINS not set)
FRONTEND_URL=https://your-frontend-domain.com

# ── Frontend API Base URL ─────────────────────────────────────
# HYBRID DEPLOY (Vercel frontend + separate backend): Set to the backend API URL.
# Example: https://matchpit-api.replit.app or https://api.matchpit.in
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ── Server ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production