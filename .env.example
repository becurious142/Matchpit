# ─────────────────────────────────────────────────────────────
# MATCHPIT — Environment Variables
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Replit provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/matchpit

# Clerk authentication (https://dashboard.clerk.com)
# Required for all authenticated routes
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Razorpay payment gateway (https://dashboard.razorpay.com)
# Without these the server runs in dev-mock mode (no real payments)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
VITE_RAZORPAY_KEY_ID=rzp_test_...

# Express session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change_me_to_a_long_random_string

# Node environment
NODE_ENV=development
