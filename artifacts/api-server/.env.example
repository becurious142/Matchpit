# Matchpit Local Development Environment Variables

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matchpit
REDIS_URL=redis://localhost:6379

# Authentication (Clerk - Test Mode)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Payments (Razorpay - Test Mode)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Notifications (Optional for local)
RESEND_API_KEY=
EMAIL_FROM="Matchpit Local <noreply@matchpit.local>"
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
SLACK_WEBHOOK_URL=

# Feature Flags
ENABLE_UPFRONT_MODEL=true
ENABLE_ATTENDANCE_VERIFICATION=true
ENABLE_REWARDS_ENGINE=true
ENABLE_NOTIFICATIONS=false
ENABLE_QUEUE_WORKERS=true
ASYNC_NOTIFICATIONS=true
ASYNC_SETTLEMENTS=true
ASYNC_CRON=true
