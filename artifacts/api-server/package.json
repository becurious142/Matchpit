{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "worker": "node --enable-source-maps ./dist/worker.mjs",
    "worker:dev": "set NODE_ENV=development && pnpm run build && pnpm run worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "dependency-cruiser src",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@clerk/backend": "^3.4.4",
    "@clerk/express": "^2.1.12",
    "@clerk/shared": "^4.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.16.0",
    "bullmq": "^5.76.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "date-fns": "^3.6.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.1",
    "ngeohash": "^0.6.3",
    "pino": "^9",
    "pino-http": "^10",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "razorpay": "^2.9.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.4.0",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.0",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^9.39.4",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.4"
  }
}
